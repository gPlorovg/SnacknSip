# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DB_NAME=snacknsip
DB_USER=snacknsip
DB_PASSWORD=snacknsip
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO (S3)
MINIO_URL=http://127.0.0.1:9000
# Публичный базовый URL для ссылок на картинки в JSON (браузер). Локально совпадает с MINIO_URL.
# За nginx без отдельного порта MinIO: http://127.0.0.1:80 или пусто = как MINIO_URL.
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=menu-images

# Telegram Bot
BOT_SECRET_TOKEN=replace-with-your-bot-secret-token

# Password encryption (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=replace-with-generated-fernet-key

# UI Docker build (optional; used by docker-compose.prod.yml ui.build.args)
# Empty NEXT_PUBLIC_API_BASE → browser uses /api on same host (recommended behind nginx).
# NEXT_PUBLIC_API_BASE=http://YOUR_VPS_IP
# API_PROXY_TARGET=http://web:8000
